# The all-in-one stack: MiniStack, and the control that fronts it.
#   cp .env.all.example .env.all
#   docker compose --env-file .env.all -f docker-compose.all.yml up -d

# The backend, and the address it is reached at.
EP_BACKEND=ministack
EP_BACKEND_URL=http://127.0.0.1:4566
# The addresses a browser and a client use. No reverse proxy: ports 4570 and 4571.
# Behind a proxy, name it instead: https://emuplane.example.com, https://emulator.example.com.
EP_CONSOLE_URL=http://localhost:4570
EP_GATEWAY_URL=http://localhost:4571
# The emulator image, at the tag this release was tested against.
MINISTACK_IMAGE=docker.io/ministackorg/ministack:1.5.40-full
TZ=Africa/Nairobi

# Where the control keeps its own tables; empty takes the emulator's endpoint.
#EP_STORE_ACCOUNT=111111111111
#EP_STORE_REGION=us-east-1
#EP_STORE_URL=

# Mail for the reset link; an empty host turns mail off.
EP_MAIL_HOST=
EP_MAIL_PORT=587
EP_MAIL_SECURITY=starttls
EP_MAIL_USER=
EP_MAIL_PASSWORD=
EP_MAIL_FROM=
EP_RESET_SECONDS=1800
