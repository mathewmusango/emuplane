# ministack-control settings. Copy to .env (gitignored) and fill in.
#
# Prefix `MC_` = this control plane. The emulator's own settings live in
# `services/ministack/.env` and use its upstream MINISTACK_* names.
# Every key here is read by the container (env_file) or used for compose
# interpolation on the host.

# --- host side (compose interpolation) ---
MC_DATA_DIR=/srv/myinfra/containers/ministack-control/data
MC_UI_PORT=4570
MC_GATEWAY_PORT=4571
# Tag of the locally built control image (localhost/ministack-control:<tag>).
MC_IMAGE_TAG=dev

# --- control plane ---
# Bearer token for scripted API access (Authorization: Bearer …). Empty disables
# bearer access; the console session is unaffected. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
MC_ADMIN_TOKEN=
CONTROL_POLL_SECONDS=10
# Regions this control advertises: all, or a comma list. Hidden for now, so the
# default (`all`) applies. A new account still starts with us-east-1 only.
# MC_REGIONS=all
MC_SESSION_SECONDS=28800
MC_AUTH_MODE=both
# Identity and tenancy audit trail; off by default, the console hides the tab when off.
MC_AUDIT=false
# How many services the dashboard shows under "Recently visited".
MC_RECENT_LIMIT=5
# Public address of the console: reset links and the OIDC redirect derive from it.
MC_PUBLIC_URL=https://ministack-control.mus.com

# --- local administrator (seeded once, only into an empty user store) ---
# The email is what `/forgot` sends to; without one the seeded admin cannot
# reset its password by mail.
MC_ADMIN_USER=admin
MC_ADMIN_EMAIL=
MC_ADMIN_PASSWORD=change-me

# --- OIDC (Keycloak, with OpenBao available) ---
# Same shape as Grafana's: switch it on, give it a client id/secret, and the
# rest follows from the realm. Provider label, scopes and the redirect URI are
# derived in code, not configured here.
MC_OIDC_ENABLED=false
# keycloak | openbao
MC_OIDC_STYLE=keycloak
MC_OIDC_REALM=my-labs
# The browser uses the public URL; the container uses the internal one.
MC_OIDC_PUBLIC_URL=https://keycloak.mus.com
MC_OIDC_INTERNAL_URL=http://security-keycloak:8080
MC_OIDC_CLIENT_ID=ministack-control
MC_OIDC_CLIENT_SECRET=
# Client role that makes an OIDC identity a global admin.
MC_OIDC_ADMIN_ROLE=global-admin

# --- email (password reset) --------------------------------------------
# Same relay as Grafana. Empty MC_SMTP_HOST hides the reset form.
# An authenticated relay usually requires MC_SMTP_FROM to be the account it
# authenticated as; leave it empty to use MC_SMTP_USER.
MC_SMTP_HOST=
MC_SMTP_PORT=587
# starttls | ssl | none
MC_SMTP_TLS=starttls
MC_SMTP_USER=
MC_SMTP_PASSWORD=
MC_SMTP_FROM=
MC_SMTP_FROM_NAME=MiniStack
# How long a reset link stays valid.
MC_RESET_TTL_SECONDS=1800

# Optional OpenTelemetry collector (OTLP/HTTP).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
