# Emuplane — deployment settings for podman/docker compose.
#
# Two kinds of setting live here, and that split is the porting contract:
#
#   container settings  — what Emuplane reads at runtime. `docker-compose.yml`
#                         passes exactly this set, so a Kubernetes ConfigMap is
#                         the same names and values.
#   deployment settings — compose and up.sh only, and they live in the compose
#                         overlay (`compose.yml`): image, network, container
#                         names, host ports.

# --- container settings -------------------------------------------------------
#The backend: its profile (control/backends.py) and its connection string.
#Profiles: generic, ministack, floci, localstack, moto.
EP_BACKEND=generic
#Required. Point it at the backend wherever it runs; up.sh falls back to
#EP_BACKEND_CONTAINER plus EP_BACKEND_PORT when this is empty.
EP_BACKEND_URL=http://backend:4566
#Addresses shown in the console
EP_CONSOLE_URL=https://emuplane.example.com
EP_GATEWAY_URL=https://backend.example.com
#Ports inside the container
EP_PORT=8080
EP_GATEWAY_PORT=4566
#Zone the console renders timestamps in (the image ships zoneinfo)
TZ=Africa/Nairobi
#Optional: where Emuplane keeps its own DynamoDB tables
#EP_STORE_ACCOUNT=111111111111
#EP_STORE_REGION=us-east-1
#EP_STORE_URL=
#Optional tuning; the code carries the same defaults
#EP_POLL_SECONDS=10
#EP_SESSION_SECONDS=28800
#EP_RECENT_LIMIT=5

#Nothing is seeded: sign up at /signup for the first account, and mint the API
#bearer token with ./scripts/token.sh — it prints once and is stored hashed.
