# Emuplane: the container's environment. `docker-compose.yml` passes exactly this set.

# The backend: its profile (control/backends.py) and its endpoint.
EP_BACKEND=ministack
EP_BACKEND_URL=http://backend:4566
EP_CONSOLE_URL=https://emuplane.example.com
# The gateway clients sign against.
EP_GATEWAY_URL=https://gateway.example.com
EP_PORT=8080
EP_GATEWAY_PORT=8081
# Zone the console renders timestamps in.
TZ=Africa/Nairobi

# Where Emuplane keeps its own DynamoDB tables; empty takes the backend's endpoint.
#EP_STORE_ACCOUNT=111111111111
#EP_STORE_REGION=us-east-1
#EP_STORE_URL=

# Optional tuning; the code carries the same defaults.
#EP_POLL_SECONDS=10
#EP_SESSION_SECONDS=28800
#EP_RECENT_LIMIT=5

# Mail for the reset link; an empty host turns mail off.
EP_MAIL_HOST=
EP_MAIL_PORT=587
EP_MAIL_SECURITY=starttls
EP_MAIL_USER=
EP_MAIL_PASSWORD=
EP_MAIL_FROM=
EP_RESET_SECONDS=1800
