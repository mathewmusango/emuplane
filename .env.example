#MC Data Directory
MC_DATA_DIR=/srv/myinfra/containers/ministack-control/data

#Ports
#Console port
MC_UI_PORT=4570
#Emulator gateway port
MC_GATEWAY_PORT=4571

#Emulator endpoint (container address)
MINISTACK_NODE_URL=http://core-ministack:4566
#Control database (inside the container)
CONTROL_DB=/var/lib/ministack/control/control.db
#Emulator node name shown in the console
MINISTACK_NODE_NAME=ministack

#Container ports (inside the container; keep in step with the published ports)
CONTROL_PORT=8080
CONTROL_GATEWAY_PORT=4566

#Addresses shown in the console
MC_CONSOLE_URL=https://ministack-control.mus.com
MC_GATEWAY_URL=https://ministack.mus.com

#Bearer token for scripted API access (seeded into .env on first run)
MC_ADMIN_TOKEN=

#Emulator poll interval in seconds
CONTROL_POLL_SECONDS=10
#Session lifetime in seconds
MC_SESSION_SECONDS=28800
#Recently visited services on the dashboard
MC_RECENT_LIMIT=5

#Seeded local administrator
MC_ADMIN_USER=admin
#Admin email (optional, recorded only)
MC_ADMIN_EMAIL=
#Admin password (seeded into .env on first run)
MC_ADMIN_PASSWORD=
