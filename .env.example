#Ports
#Console port
MC_UI_PORT=4570
#Emulator gateway port
MC_GATEWAY_PORT=4571
#Zone the console renders timestamps in (the image ships zoneinfo)
TZ=Africa/Nairobi

#Emulator endpoint (container address)
MINISTACK_NODE_URL=http://ministack:4566
#Optional: the account and region the control reads its own DynamoDB tables as.
#Defaults are 111111111111, us-east-1 and MINISTACK_NODE_URL; set them only to
#move the control's own state somewhere else.
#MC_STORE_ACCOUNT=111111111111
#MC_STORE_REGION=us-east-1
#MC_STORE_URL=
#Optional: the node name the console shows. Empty means the emulator's compose
#service name.
#MINISTACK_NODE_NAME=ministack

#Container ports (inside the container; keep in step with the published ports)
CONTROL_PORT=8080
CONTROL_GATEWAY_PORT=4566

#Addresses shown in the console
MC_CONSOLE_URL=http://127.0.0.1:4570
MC_GATEWAY_URL=http://127.0.0.1:4571

#Bearer token for scripted API access (seeded into .env on first run)
MC_ADMIN_TOKEN=

#Emulator poll interval in seconds
CONTROL_POLL_SECONDS=10
#Session lifetime in seconds
MC_SESSION_SECONDS=28800
#Recently visited services on the dashboard
MC_RECENT_LIMIT=5

#No seeded account: a fresh control only offers sign-up, and the first account
#created becomes the platform owner. An older .env may still carry
#MC_ADMIN_USER/_EMAIL/_PASSWORD - nothing reads them any more.
MC_EMULATOR_CONTAINER=ministack
MC_PROJECT_NAME=ministack-control
#Optional compose overlay (defaults to compose.yml when present: container names, routes, external network)
MC_OVERLAY=
#Network the overlay joins (created by up.sh when missing)
MC_NETWORK=
MC_IMAGE=ghcr.io/mathewmusango/ministack-control:latest
