# ministack-control settings. Copy to .env (gitignored) and fill in.
#
# Passed verbatim by env_file — every key below is an environment variable the
# container reads — and used for compose interpolation on the host.
# The emulator's own settings live in `services/ministack/.env`.

# --- host side (compose interpolation) ---
# Accounts, sessions, the bucket registry and the audit trail.
MINISTACK_CONTROL_DATA_DIR=/srv/myinfra/containers/ministack/data/control
MINISTACK_UI_PORT=4570
MINISTACK_GATEWAY_PORT=4571
# Tag of the locally built control image (localhost/ministack-control:<tag>).
MINISTACK_CONTROL_TAG=dev

# --- control plane ---
# Bearer token for scripted API access (Authorization: Bearer …).
MINISTACK_ADMIN_TOKEN=
CONTROL_POLL_SECONDS=10
# Regions this control advertises: all, or a comma list. A new account starts
# with us-east-1 only; regions are opt-in per account in Settings.
MINISTACK_REGIONS=all

# --- login (local admin) ---
# The console is the only way in; an empty password disables local sign-in.
MINISTACK_SESSION_SECONDS=28800
MINISTACK_AUTH_MODE=both
# Identity and tenancy audit trail; off by default, the console hides the tab when off.
MINISTACK_AUDIT=false
# How many services the dashboard shows under "Recently visited".
MINISTACK_RECENT_LIMIT=5

# --- OIDC (Keycloak) ---
# keycloak | openbao. Endpoints come from discovery; the browser uses the
# public URL and the control container the internal one.
MINISTACK_OIDC_ENABLED=false
OIDC_STYLE=keycloak
OIDC_PUBLIC_URL=https://keycloak.mus.com
OIDC_INTERNAL_URL=http://security-keycloak:8080
OIDC_REALM=my-labs
OIDC_PROVIDER_LABEL=Keycloak
OIDC_SCOPES=openid profile email
OIDC_CLIENT_ID=ministack-control
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://ministack.mus.com/oidc/callback
# Client role that makes an OIDC identity a global admin.
OIDC_ADMIN_ROLE=global-admin

# --- email (password reset) ---------------------------------------------
# Same relay as Grafana. Empty MINISTACK_SMTP_HOST hides the reset form.
MINISTACK_SMTP_HOST=
MINISTACK_SMTP_PORT=587
# starttls | ssl | none
MINISTACK_SMTP_TLS=starttls
MINISTACK_SMTP_USER=
MINISTACK_SMTP_PASSWORD=
MINISTACK_SMTP_FROM=ministack@mus.com
MINISTACK_SMTP_FROM_NAME=MiniStack
# Links in reset mail point here.
MINISTACK_PUBLIC_URL=https://ministack.mus.com
# How long a reset link stays valid.
MINISTACK_RESET_TTL_SECONDS=1800

# --- resource browser (StackPort) --------------------------------------
# Point it at an account: its 12-digit root ID (any secret) or an issued IAM
# key. Composed as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY for the container.
STACKPORT_ACCESS_KEY_ID=
STACKPORT_SECRET_ACCESS_KEY=
STACKPORT_ALLOW_WRITES=true

# Bootstrap administrator, seeded only when the user store is empty.
MINISTACK_ADMIN_USER=admin
MINISTACK_ADMIN_PASSWORD=change-me

# Optional OpenTelemetry collector (OTLP/HTTP).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
