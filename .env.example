# MiniStack control plane — deployment settings for podman/docker compose.
#
# Two kinds of setting live here, and that split is the porting contract:
#
#   container settings  — what the control reads at runtime. `docker-compose.yml`
#                         passes exactly this set, so a Kubernetes ConfigMap is
#                         the same names and values.
#   deployment settings — compose and up.sh only: image, network, the node's
#                         container, host ports. Kubernetes supplies these as
#                         manifest fields (image, Service/Endpoints, DNS) and
#                         never injects them into the container.

# --- container settings -------------------------------------------------------
#Addresses shown in the console
MC_CONSOLE_URL=https://ministack-control.example.com
MC_GATEWAY_URL=https://ministack.example.com
#The node the control fronts. Empty means up.sh derives it from MC_NODE_CONTAINER
#(or MC_NODE_LABEL); a Kubernetes deployment names the Service here, e.g.
#http://ministack.ministack.svc:4566
MC_NODE_URL=
#Node label in the console; empty means the URL's host
MC_NODE_NAME=
#Ports inside the container
CONTROL_PORT=8080
CONTROL_GATEWAY_PORT=4566
#Zone the console renders timestamps in (the image ships zoneinfo)
TZ=Africa/Nairobi
#Optional: where the control keeps its own DynamoDB tables
#MC_STORE_ACCOUNT=111111111111
#MC_STORE_REGION=us-east-1
#MC_STORE_URL=
#Optional tuning; the code carries the same defaults
#CONTROL_POLL_SECONDS=10
#MC_SESSION_SECONDS=28800
#MC_RECENT_LIMIT=5

# --- deployment settings (compose and up.sh only) ------------------------------
#Image to run
MC_IMAGE=ghcr.io/mathewmusango/ministack-control:latest
#Host ports compose publishes (Kubernetes uses a Service instead)
MC_UI_PORT=4570
MC_GATEWAY_PORT=4571
#The node: its container name, or a label to discover it by (either is enough)
MC_NODE_CONTAINER=
MC_NODE_LABEL=
MC_NODE_PORT=4566
#The control container scripts/token.sh execs into; empty means discover by label
#MC_CONTROL_CONTAINER=
#External network the overlay joins (created by up.sh when missing)
MC_NETWORK=

#Nothing is seeded: sign up at /signup for the first account, and mint the API
#bearer token with ./scripts/token.sh — it prints once and is stored hashed,
#never in this file.
