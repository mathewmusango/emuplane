{
  "prefix": "Changelog:",
  "sections": [
    { "title": "Added", "labels": ["added", "feature", "enhancement"] },
    { "title": "Changed", "labels": ["changed", "improvement"] },
    { "title": "Deprecated", "labels": ["deprecated"] },
    { "title": "Removed", "labels": ["removed"] },
    { "title": "Fixed", "labels": ["fixed", "bug"] },
    { "title": "Security", "labels": ["security"] }
  ],
  "exclude_labels": [
    "skip-changelog",
    "chore",
    "internal",
    "question",
    "duplicate",
    "invalid",
    "wontfix"
  ],
  "unlabelled": "Changed"
}
