{
  "prefix": "Changelog:",
  "documentation_prefix": "Documentation:",
  "sections": [
    { "title": "Added", "labels": ["added", "feature", "enhancement"], "color": "0e8a16", "bump": "minor" },
    { "title": "Changed", "labels": ["changed", "improvement"], "color": "1d76db", "bump": "minor" },
    { "title": "Deprecated", "labels": ["deprecated"], "color": "fbca04", "bump": "minor" },
    { "title": "Removed", "labels": ["removed"], "color": "d93f0b", "bump": "major" },
    { "title": "Fixed", "labels": ["fixed", "bug"], "color": "b60205", "bump": "patch" },
    { "title": "Security", "labels": ["security"], "color": "5319e7", "bump": "patch" }
  ],
  "exclude_labels": [
    "skip-changelog",
    "chore",
    "internal",
    "documentation",
    "question",
    "duplicate",
    "invalid",
    "wontfix"
  ],
  "exclude_color": "ededed",
  "unlabelled": "Changed",
  "policy": { "auto": ["patch"] }
}
