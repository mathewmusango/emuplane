{
  "prefix": "Changelog:",
  "sections": [
    { "title": "Added", "labels": ["added", "feature", "enhancement"], "color": "0e8a16" },
    { "title": "Changed", "labels": ["changed", "improvement"], "color": "1d76db" },
    { "title": "Deprecated", "labels": ["deprecated"], "color": "fbca04" },
    { "title": "Removed", "labels": ["removed"], "color": "d93f0b" },
    { "title": "Fixed", "labels": ["fixed", "bug"], "color": "b60205" },
    { "title": "Security", "labels": ["security"], "color": "5319e7" }
  ],
  "exclude_labels": [
    "skip-changelog",
    "chore",
    "internal",
    "question",
    "duplicate",
    "invalid",
    "wontfix"
  ],
  "exclude_color": "ededed",
  "unlabelled": "Changed"
}
