# Installed dependencies, and the `tests/node_modules` symlink that lets the
# console suite resolve them from outside `web/`. A symlink is not a directory,
# so the trailing-slash pattern alone would miss it.
node_modules/
tests/node_modules
# pytest's own cache, from `python3 -m pytest tests`.
.pytest_cache/

# The documentation site: dependencies, build output, npm's cache.
site/node_modules/
site/build/
site/.docusaurus/
site/.npm-cache/

qa/
addons/
my-docs/
# Internal design notes: cells, router, break-glass. Not for a public repo.
ARCHITECTURE.md
