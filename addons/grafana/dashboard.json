{
  "uid": "ministack",
  "title": "ministack",
  "description": "Status and panels for ministack. The first panel is the up/down box every service dashboard starts with.",
  "tags": ["lab", "ministack", "addon"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Status",
      "description": "up{job=\"ministack\"}: 1 = Prometheus is scraping ministack, 0 = it is not. No data means the scrape job is missing or named differently (see addons/prometheus/scrape.yml).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [{ "type": "value", "options": { "0": { "index": 1, "text": "DOWN" }, "1": { "index": 0, "text": "UP" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=\"ministack\"}",
          "legendFormat": "ministack"
        }
      ]
    }
  ]
}
