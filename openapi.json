{
  "openapi": "3.0.3",
  "info": {
    "title": "Emuplane control API",
    "version": "v1",
    "description": "The console's own HTTP API, served on the control port. Generated from control/app.py by scripts/openapi.py. The AWS gateway on port 4571 is a different API and is not described here."
  },
  "servers": [
    {
      "url": "http://localhost:4570",
      "description": "The control container's published address."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "The token minted inside the container by python /app/api_token.py. A console session cookie is accepted too, but only for its own account."
      }
    }
  },
